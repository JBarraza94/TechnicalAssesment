{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Auth": {
    "Enabled": false,
    "Issuer": "CompanyApi",
    "Audience": "CompanyApp",
    "TokenLifetimeMinutes": 60,
    "SigningKey": "",
    "Users": []
  },
  "Relevance": {
    "Threshold": 0.5,
    "SearchMinScore": 0.3,
    "EnableContentInspection": false,
    "ContentTimeoutSeconds": 3,
    "ContentMaxBytes": 262144
  }
}
